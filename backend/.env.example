# Copy to backend/.env to override defaults (all optional).

# Max upload size in MB (nginx client_max_body_size is 4200m — raise both together).
MAX_UPLOAD_MB=4096

# Vulkan device index for video2x. Empty = first discrete GPU (RTX 4070 on this host).
# List devices: LD_LIBRARY_PATH=engine/build/install/lib engine/build/install/bin/video2x -l
VULKAN_DEVICE=

# Where uploads, results and jobs.db live.
# STORAGE_DIR=/home/dedsec995/Desktop/video2x/backend/storage
